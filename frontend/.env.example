# =============================================================================
# ADVERSUM — Frontend (Vite) environment configuration
# =============================================================================
# Copier en `.env` :  cp .env.example .env
# Seules les variables préfixées VITE_ sont exposées au bundle client.
# ATTENTION : tout ce qui est préfixé VITE_ est PUBLIC (lisible dans dist/).
# Ne jamais y placer de secret de production (Nebius, Tavily, DB...).
# =============================================================================

# --- Backend API -------------------------------------------------------------
# URL de base du backend FastAPI.
#   Vide  -> même origine : /api et /ws sont proxyfiés par Vite (dev) ou Nginx (prod).
#   Sinon -> URL absolue, ex. https://api.adversum.example
VITE_API_URL=

# --- API key -----------------------------------------------------------------
# Clé envoyée dans l'en-tête X-API-Key (et ?api_key= sur le WebSocket).
# Doit correspondre à API_KEY côté backend (voir le .env racine).
# Laisser VIDE en production : la clé est alors injectée par la passerelle/reverse-proxy.
VITE_API_KEY=
