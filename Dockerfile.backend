# =============================================================================
# Adversum Backend — Multi-stage Build (Rust Core + FastAPI Engine)
# Optimized for Nebius AI Cloud (MK8s & Container Runtimes)
# =============================================================================

# --- Stage 1: Rust Core Builder ---
FROM python:3.11-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# Install maturin for PyO3 wheel building
RUN pip install --no-cache-dir maturin

WORKDIR /app

# Copy Rust core source
COPY core/ /app/core/

# Build optimized release wheel for Linux x86_64
WORKDIR /app/core
RUN maturin build --release --out /app/dist


# --- Stage 2: Final Production Runtime ---
FROM python:3.11-slim

LABEL maintainer="Adversum Security Team"
LABEL description="Adversum AI Security Engine on Nebius AI Cloud"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PORT=8000 \
    APP_ENV=production

WORKDIR /app

# System runtime dependencies (git required for cloning repos during audit)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    sqlite3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-root application user for container security
RUN groupadd -r -g 1000 appuser && \
    useradd -r -u 1000 -g appuser -m -d /home/appuser appuser

# Copy and install the compiled Rust Core PyO3 wheel
COPY --from=builder /app/dist /app/dist
RUN pip install --no-cache-dir /app/dist/*.whl && rm -rf /app/dist

# Install Python requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir tavily-python

# Copy full application codebase
COPY . .

# Set permissions for non-root user
RUN chown -R appuser:appuser /app /home/appuser

USER appuser

EXPOSE 8000

# Container Healthcheck (Nebius AI Cloud & K8s compatibility)
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

# Start FastAPI with Uvicorn
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
