# =============================================================================
# Adversum Scanner — Isolated Container for Ephemeral GitHub SAST
# Designed for Nebius AI Cloud / Ephemeral Jobs
# =============================================================================

FROM python:3.12-slim

LABEL maintainer="Adversum Security Team"
LABEL description="Isolated SAST Scanner container for Adversum"

# Install git and CA certificates for cloning remote repositories
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Run as non-root user for security sandboxing
RUN groupadd -r -g 1001 scanneruser && \
    useradd -r -u 1001 -g scanneruser -m -d /home/scanneruser scanneruser

WORKDIR /scanner

COPY scripts/scanner/entrypoint.py .
RUN chown -R scanneruser:scanneruser /scanner /home/scanneruser

USER scanneruser
ENV PYTHONUNBUFFERED=1

CMD ["python", "entrypoint.py"]
