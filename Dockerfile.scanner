# ============================================================
# Adversum Scanner — Isolated Container for GitHub Repo SAST
# ============================================================
# This lightweight container:
# 1. Clones any GitHub repository (shallow)
# 2. Runs the multi-language SAST engine (Python fallback)
# 3. Outputs a JSON or text report, then exits
# ============================================================

FROM python:3.12-slim

# Install system dependencies: git for cloning
RUN apt-get update && apt-get install -y \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /scanner

# Copy only the scanner entrypoint (no full app deps needed)
COPY scripts/scanner/entrypoint.py .

# No pip install needed — standalone script, zero dependencies
CMD ["python", "entrypoint.py"]
