# --- Backend API Security & CORS ---
API_KEY=adv-dev-key-123
ALLOWED_SCAN_DIR=C:/Users/SMC-DXB/Projects/Adversum
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
MAX_REQUEST_BODY_BYTES=26214400

# --- Database Concurrency & Persistence ---
# Default: High-concurrency SQLite with WAL mode enabled
DATABASE_URL=sqlite+aiosqlite:///adversum_local.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://adversum:securepassword@localhost:5432/adversum_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# --- Nebius AI Cloud / Token Factory (NVIDIA NIM) ---
# Obtain your API key at: https://tokenfactory.nebius.com
# Set NEBIUS_MOCK=1 to enable offline mock mode for zero-cost local testing
NEBIUS_MOCK=1
NEBIUS_API_KEY=your_nebius_token_factory_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning

# --- Tavily Live Threat Intelligence (CVE & Advisory Correlation) ---
# Obtain your API key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# --- EVM Infrastructure & Anvil Live Fork (Phase 1 & 3) ---
# Live Ethereum Mainnet RPC endpoint for empirical exploit validation (Anvil fork)
ANVIL_FORK_RPC_URL=https://eth.llamarpc.com
ANVIL_PORT=8545

# --- Redis Event Bus & WebSocket Scalability (Phase 2 & 5) ---
REDIS_URL=redis://localhost:6379/0

# --- Autonomous Threat Hunter Daemon (Phase 5) ---
THREAT_HUNTER_CHAIN=ethereum
THREAT_HUNTER_INTERVAL=2.0

# --- Observability & Telemetry ---
LOG_LEVEL=INFO
