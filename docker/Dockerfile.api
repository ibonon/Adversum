# ==============================================================================
# Adversum Production API Container — Multi-stage Build
# Rust Core (PyO3) + FastAPI Multi-Worker Engine + Non-Root Security
# ==============================================================================

# --- Stage 1: Rust Core Builder ---
FROM python:3.11-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"

# Install maturin for PyO3 wheel building
RUN pip install --no-cache-dir maturin

WORKDIR /app

# Copy Rust core source and build wheel
COPY core/ /app/core/
WORKDIR /app/core
RUN maturin build --release --out /app/dist


# --- Stage 2: Final Production Runtime ---
FROM python:3.11-slim AS runtime

LABEL maintainer="Adversum Security Team"
LABEL description="Adversum AI Security Engine & Autonomous SOC"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    PORT=8000 \
    APP_ENV=production

WORKDIR /app

# System runtime dependencies (git, curl for healthchecks)
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    sqlite3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged application user
RUN groupadd -r -g 1000 appuser && \
    useradd -r -u 1000 -g appuser -m -d /home/appuser appuser

# Install compiled Rust core wheel
COPY --from=builder /app/dist /app/dist
RUN pip install --no-cache-dir /app/dist/*.whl && rm -rf /app/dist

# Install Python requirements
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir tavily-python

# Copy application code
COPY api/ api/
COPY orchestrator/ orchestrator/
COPY modules/ modules/
COPY contracts/ contracts/
COPY cli.py .
COPY pytest.ini .

# Set permissions for non-root user
RUN chown -R appuser:appuser /app /home/appuser
USER appuser

EXPOSE 8000

# Healthcheck
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health/live || exit 1

# Production multi-worker entrypoint
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
